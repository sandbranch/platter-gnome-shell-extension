      },
      "align": "center",
      "wrap": false,
      "overflow": {
        "mode": "scroll",
        "maxchars": 40
      }
    },
    {
      "type": "text",
      "x": 85,
      "y": 39,
      "width": 150,
      "bind": "artist",
      "font": {
        "family": "Helvetica",
        "size": 7,
