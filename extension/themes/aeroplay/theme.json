      "states": {
        "default": {
          "normal": "prev.png",
          "hover": "prev-hover.png",
          "pressed": "prev-pressed.png"
        }
      }
    },
    {
      "type": "button",
      "x": 71,
      "y": 33,
      "width": 70,
      "height": 77,
      "action": "next",
      "states": {
        "default": {
          "normal": "next.png",
          "hover": "next-hover.png",
          "pressed": "next-pressed.png"
        }
      }
    },
    {
      "type": "button",
      "x": 141,
      "y": 33,
      "width": 35,
      "height": 77,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": "play-hover.png",
          "pressed": "play-pressed.png"
