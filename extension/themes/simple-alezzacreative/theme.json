{
  "format": "platter-theme/0",
  "id": "simple-alezzacreative",
  "name": "Simple (alezzacreative)",
  "canvas": {
    "width": 168,
    "height": 270
  },
  "attribution": {
    "author": "alezzacreative (MUSTAPHA ASBBAR)",
    "source_url": "https://www.deviantart.com/alezzacreative/art/Simple-CoverGloobus-skin-310562540",
    "license": "attribution-required",
    "original_app": "covergloobus",
    "upstream_author": null,
    "distribution": "free",
    "license_note": "skin.xml comment: \"this theme is free to distribute, mod and such as long as you accredit it back to MUSTAPHA ASBBAR\" (the same grant as Bulles)."
  },
  "fonts": [
    {
      "family": "Sans",
      "bundled": false,
      "reason": "named by the theme, never bundled with it"
    }
  ],
  "layers": [
    {
      "type": "artwork",
      "x": 0,
      "y": 41,
      "width": 168,
      "height": 168,
      "round": 0
    },
    {
      "type": "image",
      "x": 0,
      "y": 41,
      "width": 168,
      "height": 168,
      "src": "note.png"
    },
    {
      "type": "seekbar",
      "x": 0,
      "y": 217,
      "width": 168,
      "height": 2,
      "back": "seekbar.back.png",
      "fill": "seekbar.top.png",
      "orientation": "horizontal"
    },
    {
      "type": "text",
      "x": 0,
      "y": 224,
      "width": 100,
      "bind": "position",
      "font": {
        "family": "Sans",
        "size": 8,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffff3f",
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 25
      }
    },
    {
      "type": "text",
      "x": 137,
      "y": 224,
      "width": 100,
      "bind": "length",
      "font": {
        "family": "Sans",
        "size": 8,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffff3f",
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 25
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 21,
      "width": 171,
      "bind": "title",
      "font": {
        "family": "Sans",
        "size": 10,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "scroll",
        "maxchars": 25
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 171,
      "bind": "artist",
      "font": {
        "family": "Sans",
        "size": 16,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "scroll",
        "maxchars": 25
      }
    },
    {
      "type": "button",
      "x": 0,
      "y": 240,
      "action": "previous",
      "states": {
        "default": {
          "normal": "prev.png",
          "hover": "prev.over.png",
          "pressed": null
        }
      },
      "width": 28,
      "height": 28
    },
    {
      "type": "button",
      "x": 70,
      "y": 240,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "pause.png",
          "hover": "pause.over.png",
          "pressed": null
        },
        "playing": {
          "normal": "play.png",
          "hover": "play.over.png",
          "pressed": null
        }
      },
      "width": 28,
      "height": 28
    },
    {
      "type": "button",
      "x": 140,
      "y": 240,
      "action": "next",
      "states": {
        "default": {
          "normal": "next.png",
          "hover": "next.over.png",
          "pressed": null
        }
      },
      "width": 28,
      "height": 28
    }
  ]
}
