{
  "format": "platter-theme/0",
  "id": "sweeth-bleu",
  "name": "Sweeth_Bleu",
  "canvas": {
    "width": 350,
    "height": 100
  },
  "attribution": {
    "author": "NowPlaying screenlet (magicrobomonkey, vrunner)",
    "source_url": "https://web.archive.org/web/2011/http://www.gnome-look.org/CONTENT/content-files/69988-NowPlaying.tar.bz2",
    "license": "GPL-2.0-or-later",
    "original_app": "nowplaying",
    "upstream_author": null,
    "distribution": "free",
    "license_note": "Released inside the NowPlaying screenlet package. NowPlayingScreenlet.py carries the GNU GPL v2-or-later header in full, and the package states no separate terms for the themes it bundles. Vinyl is the one exception and is not included: its own skin.xml states CC BY-NC-SA."
  },
  "fonts": [
    {
      "family": "Vibrocentric",
      "bundled": false,
      "reason": "Vibrocentric.ttf ships with the theme, but whether it may be redistributed is unresolved"
    }
  ],
  "layers": [
    {
      "type": "image",
      "x": 0,
      "y": 0,
      "width": 290,
      "height": 85,
      "src": "background.png"
    },
    {
      "type": "artwork",
      "x": 232,
      "y": 16,
      "width": 43,
      "height": 43
    },
    {
      "type": "image",
      "x": 227,
      "y": 11,
      "width": 53,
      "height": 53,
      "src": "frame.png"
    },
    {
      "type": "text",
      "x": 15,
      "y": 14,
      "width": 200,
      "bind": "title",
      "font": {
        "family": "Vibrocentric",
        "size": 13,
        "weight": "bold",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000bb",
        "dx": 1,
        "dy": 1
      },
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 50
      }
    },
    {
      "type": "text",
      "x": 15,
      "y": 36,
      "width": 200,
      "bind": "artist",
      "font": {
        "family": "Vibrocentric",
        "size": 11,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000bb",
        "dx": 1,
        "dy": 1
      },
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 50
      }
    },
    {
      "type": "text",
      "x": 15,
      "y": 52,
      "width": 200,
      "bind": "album",
      "font": {
        "family": "Vibrocentric",
        "size": 11,
        "weight": "normal",
        "style": "italic"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000bb",
        "dx": 1,
        "dy": 1
      },
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 60
      }
    },
    {
      "type": "button",
      "x": 127,
      "y": 42,
      "width": 32,
      "height": 24,
      "action": "previous",
      "states": {
        "default": {
          "normal": "prev.png",
          "hover": "prev-hover.png",
          "pressed": "prev-pressed.png"
        }
      }
    },
    {
      "type": "button",
      "x": 159,
      "y": 42,
      "width": 32,
      "height": 24,
      "action": "next",
      "states": {
        "default": {
          "normal": "next.png",
          "hover": "next-hover.png",
          "pressed": "next-pressed.png"
        }
      }
    },
    {
      "type": "button",
      "x": 191,
      "y": 42,
      "width": 32,
      "height": 24,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": "play-hover.png",
          "pressed": "play-pressed.png"
        },
        "playing": {
          "normal": "pause.png",
          "hover": "pause-hover.png",
          "pressed": "pause-pressed.png"
        }
      }
    }
  ]
}
