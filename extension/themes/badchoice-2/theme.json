{
  "format": "platter-theme/0",
  "id": "badchoice-2",
  "name": "BadChoice",
  "canvas": {
    "width": 270,
    "height": 250
  },
  "attribution": {
    "author": "Jordi Puigdellivol Hernandez (BadChoice)",
    "source_url": "https://github.com/deepin-espanol/covergloobus",
    "license": "GPL-3.0",
    "original_app": "covergloobus",
    "upstream_author": null,
    "distribution": "free",
    "license_note": "Released as part of the CoverGloobus source package, which is GPL-3.0 (COPYING in the tarball). The themes are build targets of that package - each has its own Makefile.am registered in configure.ac and is installed by make install - so they were distributed under its licence."
  },
  "fonts": [
    {
      "family": "Lucida Grande",
      "bundled": false,
      "reason": "named by the theme, never bundled with it"
    }
  ],
  "layers": [
    {
      "type": "rating",
      "x": 210,
      "y": 60,
      "width": 20,
      "height": 20,
      "star": "star.png",
      "empty": "noStar.png",
      "spacing": 3,
      "direction": "vertical"
    },
    {
      "type": "image",
      "x": 57,
      "y": 33,
      "width": 152,
      "height": 152,
      "src": "shadow.png"
    },
    {
      "type": "image",
      "x": 63,
      "y": 39,
      "width": 139,
      "height": 139,
      "reflect": {
        "gap": 5,
        "height": 40,
        "alpha": 0.5,
        "resize": 1.0
      },
      "src": "nocover.png",
      "round": 20
    },
    {
      "type": "artwork",
      "x": 63,
      "y": 39,
      "width": 139,
      "height": 139,
      "reflect": {
        "gap": 5,
        "height": 40,
        "alpha": 0.5,
        "resize": 1.0
      },
      "round": 20
    },
    {
      "type": "text",
      "x": 18,
      "y": 185,
      "width": 230,
      "bind": "title",
      "font": {
        "family": "Lucida Grande",
        "size": 11,
        "weight": "bold",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000ff",
        "dx": 1,
        "dy": 1
      },
      "align": "center",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 25
      }
    },
    {
      "type": "text",
      "x": 18,
      "y": 205,
      "width": 230,
      "bind": "artist",
      "font": {
        "family": "Lucida Grande",
        "size": 10,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000ff",
        "dx": 1,
        "dy": 1
      },
      "align": "center",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 44
      }
    },
    {
      "type": "text",
      "x": 18,
      "y": 220,
      "width": 230,
      "bind": "album",
      "font": {
        "family": "Lucida Grande",
        "size": 10,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000ff",
        "dx": 1,
        "dy": 1
      },
      "align": "center",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 44
      }
    },
    {
      "type": "button",
      "x": 103,
      "y": 150,
      "action": "previous",
      "states": {
        "default": {
          "normal": "prev.png",
          "hover": "prev_hover.png",
          "pressed": null
        }
      },
      "width": 20,
      "height": 20
    },
    {
      "type": "button",
      "x": 125,
      "y": 150,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": "play_hover.png",
          "pressed": null
        },
        "playing": {
          "normal": "pause.png",
          "hover": "pause_hover.png",
          "pressed": null
        }
      },
      "width": 20,
      "height": 20
    },
    {
      "type": "button",
      "x": 145,
      "y": 150,
      "action": "next",
      "states": {
        "default": {
          "normal": "next.png",
          "hover": "next_hover.png",
          "pressed": null
        }
      },
      "width": 20,
      "height": 20
    }
  ]
}
