{
  "format": "platter-theme/0",
  "id": "edge-coverz",
  "name": "Edge (coverz)",
  "canvas": {
    "width": 150,
    "height": 150
  },
  "attribution": {
    "author": "mickyz",
    "source_url": "",
    "license": "GPL-3.0-or-later",
    "original_app": "coverz",
    "upstream_author": null,
    "distribution": "free",
    "license_note": "The coverz source files state: \"This application is released under the GNU General Public License v3 (or, at your option, any later version)\". The skins are part of the package: the Makefile's deb target installs skins/ with the program, and every skin is signed \"mickyz(c)2012\", coverz's own author. Same basis as the CoverGloobus 1.6/1.7 tarball themes."
  },
  "fonts": [
    {
      "family": "Droid Sans",
      "bundled": false,
      "reason": "named by the theme, never bundled with it"
    }
  ],
  "layers": [
    {
      "type": "image",
      "x": 15,
      "y": 0,
      "width": 135,
      "height": 135,
      "src": "no.png"
    },
    {
      "type": "artwork",
      "x": 15,
      "y": 0,
      "width": 135,
      "height": 135
    },
    {
      "type": "image",
      "x": 0,
      "y": 0,
      "width": 150,
      "height": 150,
      "src": "bg.png"
    },
    {
      "type": "text",
      "x": 20,
      "y": 120,
      "width": 120,
      "height": 25,
      "bind": "title",
      "font": {
        "family": "Droid Sans",
        "size": 8,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#222222ff",
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "ellipsize-char"
      }
    },
    {
      "type": "button",
      "x": 20,
      "y": 102,
      "width": 16,
      "height": 16,
      "action": "previous",
      "states": {
        "default": {
          "normal": "prev.png",
          "hover": null,
          "pressed": null
        }
      }
    },
    {
      "type": "button",
      "x": 36,
      "y": 102,
      "width": 16,
      "height": 16,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": null,
          "pressed": null
        },
        "playing": {
          "normal": "pause.png",
          "hover": null,
          "pressed": null
        }
      }
    },
    {
      "type": "button",
      "x": 52,
      "y": 102,
      "width": 16,
      "height": 16,
      "action": "next",
      "states": {
        "default": {
          "normal": "next.png",
          "hover": null,
          "pressed": null
        }
      }
    }
  ]
}
