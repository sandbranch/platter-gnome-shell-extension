{
  "format": "platter-theme/0",
  "id": "tooltip-coverz",
  "name": "Tooltip (coverz)",
  "canvas": {
    "width": 190,
    "height": 120
  },
  "attribution": {
    "author": "mickyz",
    "source_url": "",
    "license": "GPL-3.0-or-later",
    "original_app": "coverz",
    "upstream_author": null,
    "distribution": "free",
    "license_note": "The coverz source files state: \"This application is released under the GNU General Public License v3 (or, at your option, any later version)\". The skins are part of the package: the Makefile's deb target installs skins/ with the program, and every skin is signed \"mickyz(c)2012\", coverz's own author. Same basis as the CoverGloobus 1.6/1.7 tarball themes."
  },
  "fonts": [
    {
      "family": "Zero Twos",
      "bundled": false,
      "reason": "named by the theme, never bundled with it"
    }
  ],
  "layers": [
    {
      "type": "image",
      "x": 0,
      "y": 0,
      "width": 180,
      "height": 120,
      "src": "bg.png"
    },
    {
      "type": "text",
      "x": 12,
      "y": 9,
      "width": 156,
      "height": 16,
      "bind": "title",
      "font": {
        "family": "Zero Twos",
        "size": 8,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ddddddff",
      "align": "center",
      "wrap": false,
      "format": "now playing",
      "overflow": {
        "mode": "ellipsize-char"
      }
    },
    {
      "type": "text",
      "x": 12,
      "y": 23,
      "width": 156,
      "height": 16,
      "bind": "title",
      "font": {
        "family": "Zero Twos",
        "size": 9,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#99ccffff",
      "align": "center",
      "wrap": false,
      "overflow": {
        "mode": "ellipsize-char"
      }
    },
    {
      "type": "button",
      "x": 67,
      "y": 59,
      "width": 48,
      "height": 48,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": null,
          "pressed": "play2.png"
        },
        "playing": {
          "normal": "pause.png",
          "hover": null,
          "pressed": "pause2.png"
        }
      }
    },
    {
      "type": "button",
      "x": 42,
      "y": 67,
      "width": 32,
      "height": 32,
      "action": "previous",
      "states": {
        "default": {
          "normal": "prev.png",
          "hover": null,
          "pressed": "prev2.png"
        }
      }
    },
    {
      "type": "button",
      "x": 108,
      "y": 67,
      "width": 32,
      "height": 32,
      "action": "next",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": null,
          "pressed": "play2.png"
        }
      }
    }
  ]
}
