{
  "format": "platter-theme/0",
  "id": "simple-2",
  "name": "simple",
  "canvas": {
    "width": 250,
    "height": 100
  },
  "attribution": {
    "author": "Jordi Puigdellivol Hernandez (BadChoice)",
    "source_url": "https://launchpad.net/covergloobus",
    "license": "GPL-3.0",
    "original_app": "covergloobus",
    "upstream_author": null,
    "distribution": "free",
    "license_note": "The bundled CoverGloobus 1.6 source (a real bzr checkout, platter-ref/upstream/covergloobus-1.6) shows every commit adding or touching this theme made by Jordi Hernandez <jordi@vengance> / <j.hernandezp@gmail.com> - the same person credited elsewhere in this corpus as BadChoice, and CoverGloobus's own lead developer. No other name appears in that history for this file. Committer isn't automatically designer, but across nine themes and dozens of commits with zero other names, this is the best evidence available."
  },
  "fonts": [
    {
      "family": "Lucida Grande",
      "bundled": false,
      "reason": "named by the theme, never bundled with it"
    }
  ],
  "layers": [
    {
      "type": "text",
      "x": 20,
      "y": 0,
      "width": 230,
      "bind": "title",
      "font": {
        "family": "Lucida Grande",
        "size": 11,
        "weight": "bold",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000ff",
        "dx": 1,
        "dy": 1
      },
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 20
      }
    },
    {
      "type": "text",
      "x": 20,
      "y": 20,
      "width": 230,
      "bind": "artist",
      "font": {
        "family": "Lucida Grande",
        "size": 10,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000ff",
        "dx": 1,
        "dy": 1
      },
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 24
      }
    },
    {
      "type": "text",
      "x": 20,
      "y": 40,
      "width": 230,
      "bind": "album",
      "font": {
        "family": "Lucida Grande",
        "size": 10,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000ff",
        "dx": 1,
        "dy": 1
      },
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 24
      }
    },
    {
      "type": "rating",
      "x": 20,
      "y": 60,
      "width": 15,
      "height": 15,
      "star": "star.png",
      "empty": "nostar.png",
      "spacing": 3,
      "direction": "horizontal"
    },
    {
      "type": "button",
      "x": 20,
      "y": 83,
      "action": "previous",
      "states": {
        "default": {
          "normal": "prev.png",
          "hover": null,
          "pressed": null
        }
      },
      "width": 20,
      "height": 16
    },
    {
      "type": "button",
      "x": 40,
      "y": 83,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": null,
          "pressed": null
        },
        "playing": {
          "normal": null,
          "hover": null,
          "pressed": null
        }
      },
      "width": 20,
      "height": 16
    },
    {
      "type": "button",
      "x": 60,
      "y": 83,
      "action": "next",
      "states": {
        "default": {
          "normal": "next.png",
          "hover": null,
          "pressed": null
        }
      },
      "width": 20,
      "height": 16
    }
  ]
}
