      "y": 37,
      "width": 72,
      "height": 70,
      "src": "userbg.png"
    },
    {
      "type": "artwork",
      "x": 452,
      "y": 37,
      "width": 68,
      "height": 69
    },
    {
      "type": "image",
      "x": 446,
      "y": 31,
      "width": 80,
      "height": 80,
      "src": "user.png"
    },
    {
      "type": "text",
      "x": 207,
      "y": 39,
      "width": 230,
      "bind": "title",
      "font": {
        "family": "Frutiger Linotype",
        "size": 9,
        "weight": "bold",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000bb",
        "dx": 1,
        "dy": 1
      },
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 50
      }
    },
    {
      "type": "text",
      "x": 207,
      "y": 62,
      "width": 230,
      "bind": "artist",
      "font": {
        "family": "Frutiger Linotype",
        "size": 8,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000bb",
        "dx": 1,
        "dy": 1
      },
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 50
      }
    },
    {
      "type": "text",
      "x": 207,
      "y": 77,
      "width": 230,
      "bind": "album",
      "font": {
        "family": "Frutiger Linotype",
        "size": 8,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffff",
      "shadow": {
        "color": "#000000bb",
        "dx": 1,
        "dy": 1
      },
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 50
