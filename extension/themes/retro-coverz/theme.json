{
  "format": "platter-theme/0",
  "id": "retro-coverz",
  "name": "Retro (coverz)",
  "canvas": {
    "width": 256,
    "height": 216
  },
  "attribution": {
    "author": "mickyz",
    "source_url": "",
    "license": "GPL-3.0-or-later",
    "original_app": "coverz",
    "upstream_author": null,
    "distribution": "free",
    "license_note": "The coverz source files state: \"This application is released under the GNU General Public License v3 (or, at your option, any later version)\". The skins are part of the package: the Makefile's deb target installs skins/ with the program, and every skin is signed \"mickyz(c)2012\", coverz's own author. Same basis as the CoverGloobus 1.6/1.7 tarball themes."
  },
  "fonts": [
    {
      "family": "Mint Spirit",
      "bundled": false,
      "reason": "named by the theme, never bundled with it"
    }
  ],
  "layers": [
    {
      "type": "image",
      "x": 48,
      "y": 56,
      "width": 160,
      "height": 160,
      "rotate": 30.0,
      "src": "coverz-nocover-bg.png"
    },
    {
      "type": "artwork",
      "x": 48,
      "y": 56,
      "width": 160,
      "height": 160,
      "rotate": 30.0,
      "mask": "coverz-cover-mask.png"
    },
    {
      "type": "image",
      "x": 0,
      "y": 0,
      "width": 256,
      "height": 256,
      "src": "coverz-image1-fg.png"
    },
    {
      "type": "text",
      "x": 20,
      "y": 142,
      "width": 216,
      "height": 20,
      "bind": "artist",
      "font": {
        "family": "Mint Spirit",
        "size": 11,
        "weight": "normal",
        "style": "normal"
      },
      "color": "#ffffffd9",
      "align": "center",
      "wrap": false,
      "format": "%artist - %title",
      "overflow": {
        "mode": "ellipsize-char"
      }
    },
    {
      "type": "button",
      "x": 110,
      "y": 180,
      "width": 35,
      "height": 35,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": null,
          "pressed": null
        },
        "playing": {
          "normal": "pause.png",
          "hover": null,
          "pressed": null
        }
      }
    },
    {
      "type": "button",
      "x": 80,
      "y": 180,
      "width": 25,
      "height": 25,
      "action": "previous",
      "states": {
        "default": {
          "normal": "prev.png",
          "hover": null,
          "pressed": null
        }
      }
    },
    {
      "type": "button",
      "x": 150,
      "y": 180,
      "width": 25,
      "height": 25,
      "action": "next",
      "states": {
        "default": {
          "normal": "next.png",
          "hover": null,
          "pressed": null
        }
      }
    },
    {
      "type": "seekbar",
      "x": 40,
      "y": 133,
      "width": 176,
      "height": 10,
      "back": null,
      "fill": null,
      "orientation": "horizontal",
      "thumb": {
        "src": "thumb.png",
        "width": 10,
        "height": 10
      }
    },
    {
      "type": "rating",
      "x": 83,
      "y": 160,
      "width": 16,
      "height": 16,
      "star": "starred.png",
      "empty": "star.png",
      "spacing": 2,
      "direction": "horizontal"
    }
  ]
}
