        "mode": "clip",
        "maxchars": 50
      }
    },
    {
      "type": "text",
      "x": 2,
      "y": 177,
      "width": 185,
      "bind": "title",
      "font": {
        "family": "Purisa",
        "size": 10,
        "weight": "normal",
