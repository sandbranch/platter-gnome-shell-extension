{
  "format": "platter-theme/0",
  "id": "mh1",
  "name": "mH1",
  "canvas": {
    "width": 166,
    "height": 254
  },
  "attribution": {
    "author": "raizon1 (edit of alezzacreative/MUSTAPHA ASBBAR's ICS 2)",
    "source_url": "",
    "license": "attribution-required",
    "original_app": "covergloobus",
    "upstream_author": null,
    "distribution": "non-free"
  },
  "fonts": [
    {
      "family": "Sansation",
      "bundled": false,
      "reason": "named by the theme, never bundled with it"
    }
  ],
  "layers": [
    {
      "type": "image",
      "x": 36,
      "y": 114,
      "width": 80,
      "height": 80,
      "src": "bg.png"
    },
    {
      "type": "artwork",
      "x": 30,
      "y": 109,
      "width": 90,
      "height": 90,
      "round": 0,
      "mask": "mask.png"
    },
    {
      "type": "text",
      "x": 8,
      "y": 190,
      "width": 149,
      "bind": "title",
      "font": {
        "family": "Sansation",
        "size": 9,
        "weight": "bold",
        "style": "normal"
      },
      "color": "#ffffffff",
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 18
      }
    },
    {
      "type": "text",
      "x": 8,
      "y": 203,
      "width": 149,
      "bind": "artist",
      "font": {
        "family": "Sansation",
        "size": 9,
        "weight": "bold",
        "style": "normal"
      },
      "color": "#dd1804ff",
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 18
      }
    },
    {
      "type": "seekbar",
      "x": 8,
      "y": 220,
      "width": 149,
      "height": 8,
      "back": "seekbar.back.png",
      "fill": "seekbar.top.png",
      "orientation": "horizontal",
      "thumb": {
        "src": "grip.png",
        "width": 22,
        "height": 21,
        "slice": {
          "top": -7,
          "right": -5,
          "bottom": 0,
          "left": -5
        }
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 235,
      "width": 100,
      "bind": "position",
      "font": {
        "family": "Sansation",
        "size": 7,
        "weight": "bold",
        "style": "normal"
      },
      "color": "#ffffffff",
      "align": "left",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 44
      }
    },
    {
      "type": "text",
      "x": 58,
      "y": 235,
      "width": 100,
      "bind": "length",
      "font": {
        "family": "Sansation",
        "size": 7,
        "weight": "bold",
        "style": "normal"
      },
      "color": "#ffffffff",
      "align": "right",
      "wrap": false,
      "overflow": {
        "mode": "clip",
        "maxchars": 44
      }
    },
    {
      "type": "button",
      "x": 38,
      "y": 235,
      "action": "previous",
      "states": {
        "default": {
          "normal": "prev.png",
          "hover": null,
          "pressed": null
        }
      },
      "width": 10,
      "height": 7
    },
    {
      "type": "button",
      "x": 80,
      "y": 235,
      "action": "play_pause",
      "states": {
        "default": {
          "normal": "play.png",
          "hover": null,
          "pressed": null
        },
        "playing": {
          "normal": "pause.png",
          "hover": null,
          "pressed": null
        }
      },
      "width": 5,
      "height": 7
    },
    {
      "type": "button",
      "x": 109,
      "y": 235,
      "action": "next",
      "states": {
        "default": {
          "normal": "next.png",
          "hover": null,
          "pressed": null
        }
      },
      "width": 10,
      "height": 7
    }
  ]
}
